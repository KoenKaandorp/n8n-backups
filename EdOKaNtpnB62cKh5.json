    {
      "parameters": {
        "options": {}
      },
      "id": "1ed548e0-fd4e-44ef-a5bc-c99e1355bc55",
      "name": "Loop Over DOIs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -1856,
        2064
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const EMAIL = $('Globals').first().json.email;\nconst { doi, title, year, filename } = $json;\nconst UA = 'Mozilla/5.0 (compatible; n8n-paper-fetcher)';\nconst http = this.helpers.httpRequest;\nconst getJson = (url) => http({ url, method:'GET', json:true, headers:{'User-Agent':UA}, timeout:20000 });\n\nconst cands = [];\nconst push = (url, host, src) => { if (url) cands.push({ url, host: host || '', src }); };\n\n// 1) Unpaywall\ntry {\n  const d = await getJson(`https://api.unpaywall.org/v2/${doi}?email=${encodeURIComponent(EMAIL)}`);\n  const locs = [];\n  if (d.best_oa_location) locs.push(d.best_oa_location);\n  if (Array.isArray(d.oa_locations)) locs.push(...d.oa_locations);\n  for (const l of locs) push(l && l.url_for_pdf, l && l.host_type, 'unpaywall');\n} catch (e) {}\n\n// 2) OpenAlex\ntry {\n  const r = await getJson(`https://api.openalex.org/works?filter=doi:${encodeURIComponent(doi)}&mailto=${encodeURIComponent(EMAIL)}`);\n  const w = r && r.results && r.results[0];\n  if (w) {\n    const locs = [];\n    if (w.best_oa_location) locs.push(w.best_oa_location);\n    if (Array.isArray(w.locations)) locs.push(...w.locations);\n    for (const l of locs) {\n      const host = (l && l.source && l.source.type === 'repository') ? 'repository' : '';\n      push(l && l.pdf_url, host, 'openalex');\n    }\n  }\n} catch (e) {}\n\n// 3) Semantic Scholar\ntry {\n  const d = await getJson(`https://api.semanticscholar.org/graph/v1/paper/DOI:${doi}?fields=openAccessPdf`);\n  push(d && d.openAccessPdf && d.openAccessPdf.url, '', 'semanticscholar');\n} catch (e) {}\n\n// 4) Europe PMC (strong for biomedical)\ntry {\n  const s = await getJson(`https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=DOI:${encodeURIComponent(doi)}&format=json&resultType=core`);\n  const hit = s && s.resultList && s.resultList.result && s.resultList.result[0];\n  if (hit && hit.pmcid) push(`https://www.ebi.ac.uk/europepmc/webservices/rest/${hit.pmcid}/fullTextPDF`, 'repository', 'europepmc');\n} catch (e) {}\n\n// 5) Crossref (occasional TDM / publisher fulltext PDF links)\ntry {\n  const d = await getJson(`https://api.crossref.org/works/${doi}?mailto=${encodeURIComponent(EMAIL)}`);\n  const links = (d.message && d.message.link) || [];\n  for (const l of links) {\n    if (String(l['content-type']).toLowerCase().includes('pdf')) push(l.URL, '', 'crossref');\n  }\n} catch (e) {}\n\n// 6) DOAJ (fully open-access journals)\ntry {\n  const q = encodeURIComponent(`doi:\"${doi}\"`);\n  const d = await getJson(`https://doaj.org/api/search/articles/${q}`);\n  const arts = (d && d.results) || [];\n  for (const a of arts) {\n    const links = (a.bibjson && a.bibjson.link) || [];\n    for (const l of links) {\n      if (String(l.type).toLowerCase() === 'fulltext') {\n        const isPdfType = String(l.content_type || '').toLowerCase().includes('pdf');\n        push(l.url, isPdfType ? 'repository' : '', 'doaj');\n      }\n    }\n  }\n} catch (e) {}\n\n// dedupe + rank (repositories / PMC first, publisher last)\nconst seen = new Set();\nconst rank = c => (c.host === 'repository' || c.src === 'europepmc') ? 0\n                : c.src === 'semanticscholar' ? 1\n                : c.host === 'publisher' ? 3 : 2;\nconst ordered = cands.filter(c => c.url && !seen.has(c.url) && seen.add(c.url)).sort((a,b) => rank(a) - rank(b));\n\n// verify: first candidate that actually serves a PDF (cheap ranged GET, skips HTML/Cloudflare)\nconst isPdf = async (url) => {\n  try {\n    const res = await http({ url, method:'GET', returnFullResponse:true, encoding:'arraybuffer',\n      headers:{'User-Agent':UA,'Accept':'application/pdf,*/*','Range':'bytes=0-4095'}, timeout:25000 });\n    const ct = String((res.headers && (res.headers['content-type'] || res.headers['Content-Type'])) || '').toLowerCase();\n    if (ct.includes('pdf')) return true;\n    if (ct.includes('html') || ct.includes('json')) return false;\n    const buf = Buffer.isBuffer(res.body) ? res.body : Buffer.from(res.body || '');\n    return buf.slice(0,5).toString('latin1') === '%PDF-';\n  } catch (e) { return false; }\n};\n\nlet pdfUrl = null, source = '', resolvedBy = '';\nfor (const c of ordered.slice(0, 8)) {\n  if (await isPdf(c.url)) { pdfUrl = c.url; source = c.host || c.src; resolvedBy = c.src; break; }\n}\n\nreturn { json: {\n  title, year, doi, filename,\n  candidateCount: ordered.length,\n  candidates: ordered.map(c => c.url),\n  pdfUrl, source, resolvedBy,\n  status: pdfUrl ? 'to_download' : 'no_pdf_any_source',\n}};"
      },
