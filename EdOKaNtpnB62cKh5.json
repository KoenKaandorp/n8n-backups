    {
      "parameters": {
        "jsCode": "const EMAIL = $('Globals').first().json.email;\nconst done  = $('Downloaded Set').first().json;\nconst doneDois   = new Set((done.downloadedDois   || []).map(d => String(d).toLowerCase()));\nconst doneTitles = new Set(done.downloadedTitles || []);\nconst norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\n\nconst out = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const apa = String(row['APA format'] ?? '');\n  const title = String(row['Title'] ?? 'untitled');\n  const year  = String(row['Year'] ?? '');\n  let doi = null;\n  const m = apa.match(/https?:\\/\\/(?:dx\\.)?doi\\.org\\/(10\\.\\d{4,9}\\/[^\\s\"'<>)]+)/i)\n         || apa.match(/\\b(10\\.\\d{4,9}\\/[^\\s\"'<>)]+)/);\n  if (m) doi = m[1].replace(/[.,;]+$/, '');\n\n  if ((doi && doneDois.has(doi.toLowerCase())) || doneTitles.has(norm(title))) continue;\n\n  const safe = title.replace(/[^a-z0-9]+/gi,'_').replace(/^_+|_+$/g,'').slice(0,80) || 'untitled';\n  out.push({ json: {\n    title, year, doi, hasDoi: Boolean(doi),\n    filename: (`${safe}_${year}`.replace(/_+$/,'')) + '.pdf',\n  }});\n}\nreturn out;\n"
      },
