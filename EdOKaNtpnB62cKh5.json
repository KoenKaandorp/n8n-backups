    {
      "parameters": {
        "jsCode": "// Collapse the download log into one lookup item. Only 'downloaded' rows count as done.\nconst dois = new Set(), titles = new Set();\nconst norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\nfor (const r of $input.all()) {\n  const j = r.json || {};\n  if (String(j.status).toLowerCase().trim() === 'downloaded') {\n    if (j.doi)   dois.add(String(j.doi).toLowerCase());\n    if (j.title) titles.add(norm(j.title));\n  }\n}\nreturn [{ json: { downloadedDois: [...dois], downloadedTitles: [...titles] }, pairedItem: { item: 0 } }];\n"
      },
      "id": "6f006c92-0a0f-4a98-a51a-86b964aa2af1",
      "name": "Downloaded Set",
      "type": "n8n-nodes-base.code",
