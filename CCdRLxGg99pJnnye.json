        "jsCode": "// Fan out one item per slide for container creation\nconst parent = $json;\nreturn parent.slide_urls.map((url, idx) => ({\n  json: {\n    _parent: { ...parent, slide_urls: undefined },\n    slide_index: idx,\n    image_url: url\n  }\n}));"
