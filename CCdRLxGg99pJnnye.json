    {
      "parameters": {
        "jsCode": "// Pairs each /media response back to its slide by position.\n// Run Once for All Items mode — returns one item per slide.\n\nconst prevAll = $('Fan Out Slides').all();\nconst items = $input.all();\n\nif (items.length !== prevAll.length) {\n  throw new Error(\n    `Got ${items.length} container responses but Fan Out Slides had ${prevAll.length}`\n  );\n}\n\nreturn items.map((item, i) => {\n  const prev = prevAll[i].json;\n  const resp = item.json;\n  if (!resp.id) {\n    throw new Error(\n      'IG /media returned no id for slide ' + (prev.slide_index + 1) +\n      '. Response: ' + JSON.stringify(resp).slice(0, 400)\n    );\n  }\n  return {\n    json: {\n      _parent: prev._parent,\n      slide_index: prev.slide_index,\n      container_id: resp.id,\n    },\n  };\n});"
      },
